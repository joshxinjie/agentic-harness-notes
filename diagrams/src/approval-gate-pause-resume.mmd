flowchart TD
    A(["Model proposes<br>a tool call"]) --> B{"Rule says<br>ask?"}
    B -->|"allow"| X["Run as usual"]
    B -->|"yes"| C[("Save checkpoint<br>+ pending call")]
    C --> D["Review card to human;<br>run stops"]
    D -.->|"hours later"| E{"Human decides"}
    E -->|"approve or edit"| F["Run the tool"]
    E -->|"reject + reason"| G["Error result<br>with the reason"]
    F --> H["Deliver as that<br>call's tool result"]
    G --> H
    H --> I(["Model carries on"])
